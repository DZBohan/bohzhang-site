---
interface Props { name: string; role: string; tagline: string; cta: string; ctaHref: string; }
const { name, role, tagline, cta, ctaHref } = Astro.props;
---

<div class="hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap hero-content">
    <p class="role">{role}</p>
    <h1>{name}</h1>
    <p class="tagline">{tagline}</p>
    <a class="btn" href={ctaHref}>{cta}</a>
  </div>
</div>

<script>
  // Decorative background: slowly drifting points with near-neighbour links.
  // Hand-written Canvas, no animation library.
  //
  // Four corrections from the 2026-09-22 design review, each verified by measurement:
  //  1. Position integrates over elapsed time, not per frame — previously a 120 Hz display
  //     ran the drift at twice the speed of a 60 Hz one.
  //  2. Pointer repulsion removed — the impulse had no decay, so the field stayed agitated
  //     long after the cursor left.
  //  3. Particles stay out of the text column, paired with a CSS gradient mask.
  //  4. Count derives from the *visible* decorated area, not the whole canvas. Lowering only
  //     the cap was close to a no-op: at 1440x900 the formula produced 78 against a cap of 110.
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const wide = window.matchMedia('(min-width: 1025px)');

  if (canvas && wide.matches) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const VISIBLE_FROM = 0.5;   // particles spawn right of this; mask fades in from 55%
    const AREA_PER_PT  = 10000; // visible px² per particle
    const MAX_PTS      = 32;
    const LINK         = 100;   // link distance
    const LINK_ALPHA   = 0.08;  // peak link opacity
    const DOT_ALPHA    = 0.30;
    const DOT_R        = 1;

    let w = 0, h = 0, raf = 0, running = false, last = 0;
    const pts: { x: number; y: number; vx: number; vy: number }[] = [];

    function seed() {
      const x0 = w * VISIBLE_FROM;
      const visibleArea = w * (1 - VISIBLE_FROM) * h;
      const n = Math.min(MAX_PTS, Math.round(visibleArea / AREA_PER_PT));
      pts.length = 0;
      for (let i = 0; i < n; i++) {
        const speed = 3 + Math.random() * 3;          // 3–6 px/s, resultant
        const a = Math.random() * Math.PI * 2;
        pts.push({
          x: x0 + Math.random() * (w - x0),
          y: Math.random() * h,
          vx: Math.cos(a) * speed,
          vy: Math.sin(a) * speed,
        });
      }
    }

    function resize() {
      const r = canvas!.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function draw(dt: number) {
      const x0 = w * VISIBLE_FROM;
      ctx.clearRect(0, 0, w, h);

      for (const p of pts) {
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        if (p.x < x0 || p.x > w) { p.vx *= -1; p.x = Math.max(x0, Math.min(w, p.x)); }
        if (p.y < 0 || p.y > h) { p.vy *= -1; p.y = Math.max(0, Math.min(h, p.y)); }
      }

      ctx.strokeStyle = '#8fb8ae'; ctx.lineWidth = 1;
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
          const d = Math.hypot(dx, dy);
          if (d < LINK) {
            ctx.globalAlpha = (1 - d / LINK) * LINK_ALPHA;
            ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = DOT_ALPHA; ctx.fillStyle = '#8fb8ae';
      for (const p of pts) { ctx.beginPath(); ctx.arc(p.x, p.y, DOT_R, 0, Math.PI * 2); ctx.fill(); }
      ctx.globalAlpha = 1;
    }

    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);  // cap at 50ms so returning to the tab doesn't jump
      last = now;
      draw(dt);
      raf = requestAnimationFrame(frame);
    }

    function start() { if (!running && !reduce) { running = true; last = performance.now(); raf = requestAnimationFrame(frame); } }
    function stop()  { if (running) { running = false; cancelAnimationFrame(raf); } }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // The first frame must not depend on IntersectionObserver: if the callback is delayed,
    // the hero renders as flat black with no recovery path.
    if (reduce) draw(0); else start();

    // The observer only pauses off-screen and resumes on re-entry.
    new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop())),
      { threshold: 0 }).observe(canvas);
  }
</script>
