---
interface Props { name: string; role: string; tagline: string; cta: string; ctaHref: string; }
const { name, role, tagline, cta, ctaHref } = Astro.props;
---

<div class="hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap hero-content">
    <p class="role">{role}</p>
    <h1>{name}</h1>
    <p class="tagline">{tagline}</p>
    <a class="btn" href={ctaHref}>{cta}</a>
  </div>
</div>

<script>
  // 首屏动效：粒子场 + 近邻连线。原生 Canvas，不引第三方库。
  // 三条克制原则：尊重 prefers-reduced-motion、离屏即暂停、按面积定粒子数。
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, dpr = 1, raf = 0, running = false;
    const pts: { x: number; y: number; vx: number; vy: number }[] = [];
    const pointer = { x: -1e4, y: -1e4 };

    function resize() {
      const r = canvas!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const target = Math.round(Math.min(110, Math.max(28, (w * h) / 13000)));
      pts.length = 0;
      for (let i = 0; i < target; i++) {
        pts.push({
          x: Math.random() * w, y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.22, vy: (Math.random() - 0.5) * 0.22,
        });
      }
    }

    function frame() {
      ctx.clearRect(0, 0, w, h);
      const LINK = 130;
      for (const p of pts) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        const dx = p.x - pointer.x, dy = p.y - pointer.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 18000 && d2 > 1) { const f = 0.00035; p.vx += dx * f; p.vy += dy * f; }
        p.vx = Math.max(-0.7, Math.min(0.7, p.vx));
        p.vy = Math.max(-0.7, Math.min(0.7, p.vy));
      }
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
          const d = Math.hypot(dx, dy);
          if (d < LINK) {
            ctx.globalAlpha = (1 - d / LINK) * 0.16;
            ctx.strokeStyle = '#5eead4'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 0.65; ctx.fillStyle = '#5eead4';
      for (const p of pts) { ctx.beginPath(); ctx.arc(p.x, p.y, 1.4, 0, Math.PI * 2); ctx.fill(); }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }

    function start() { if (!running && !reduce) { running = true; raf = requestAnimationFrame(frame); } }
    function stop() { if (running) { running = false; cancelAnimationFrame(raf); } }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('pointermove', (e) => {
      const r = canvas!.getBoundingClientRect();
      pointer.x = e.clientX - r.left; pointer.y = e.clientY - r.top;
    }, { passive: true });
    window.addEventListener('pointerleave', () => { pointer.x = pointer.y = -1e4; }, { passive: true });

    // 滚出视口就停，省电
    new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop())),
      { threshold: 0 }).observe(canvas);

    if (reduce) { frame(); cancelAnimationFrame(raf); }  // 只画一帧静态图
  }
</script>
