---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { useTranslations, projects } from '../../i18n/ui';
const lang = 'zh' as const;
const t = useTranslations(lang);
const cards = projects[lang];
---

<Base lang={lang} title="张伯晗" description={t('hero.tagline')}>
  <Hero name={t('hero.name')} role={t('hero.role')} tagline={t('hero.tagline')}
        cta={t('hero.cta')} ctaHref="#work" />

  <section id="about" class="wrap">
    <h2>{t('about.title')}</h2>
    <p>{t('about.body')}</p>
  </section>

  <section id="work" class="wrap">
    <h2>{t('research.title')}</h2>
    <p>{t('research.body')}</p>
    <h3 style="font-size:1rem;margin:2rem 0 .5rem">{t('research.pubs')}</h3>
    <p class="muted">{t('research.pubsNote')}</p>
  </section>

  <section id="projects" class="wrap">
    <h2>{t('projects.title')}</h2>
    <p>{t('projects.body')}</p>
    <div class="cards">
      {cards.map((c) => (
        <div class="card">
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="wrap">
    <h2>{t('contact.title')}</h2>
    <p>{t('contact.body')} <a href="mailto:bohanzh7@gmail.com">bohanzh7@gmail.com</a></p>
  </section>
</Base>
