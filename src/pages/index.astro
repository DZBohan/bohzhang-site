---
// Root path -> English by default. A meta refresh plus canonical is the most
// dependable approach on static hosting, with a script for returning readers.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="https://bohzhang.com/en/" />
    <title>Bohan Zhang</title>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">/en/</a> …</p>
    <script is:inline>
      // Returning readers land on whichever language they last chose; new ones get English.
      try {
        var saved = localStorage.getItem('lang');
        location.replace(saved === 'zh' ? '/zh/' : '/en/');
      } catch (e) { location.replace('/en/'); }
    </script>
  </body>
</html>
